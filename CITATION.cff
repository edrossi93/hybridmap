cff-version: 1.2.0
message: If you use this deposit, please cite the paper and the deposit itself.
title: >-
  Data and analysis code for estimating the flexural modulus of a hybrid
  flax/basalt/PA-11 laminate from high-speed nanoindentation mapping and a
  rule of mixtures
type: dataset
# Two licences, because the deposit is two things. CFF 1.2 takes a list here,
# and the pair matches LICENSE at the root, which covers scripts/ and tests/,
# and data/LICENSE, which covers the measurements.
license:
  - MIT
  - CC-BY-4.0
authors:
  - given-names: Edoardo
    family-names: Rossi
    affiliation: >-
      Department of Civil, Computer Science and Aeronautical Technologies,
      Università degli Studi Roma Tre, Rome, Italy
  - given-names: Pietro
    family-names: Russo
    affiliation: >-
      Institute for Polymers, Composites and Biomaterials, National Research
      Council, Pozzuoli, Italy
  - given-names: Fabrizio
    family-names: Sarasini
    affiliation: >-
      Department of Chemical Engineering Materials Environment, Sapienza
      Università di Roma, Rome, Italy
  - given-names: Jacopo
    family-names: Tirillò
    affiliation: >-
      Department of Chemical Engineering Materials Environment, Sapienza
      Università di Roma, Rome, Italy
  # Dual affiliation in the manuscript, superscripts 1 and 2. CITATION.cff
  # allows one affiliation string per author, so both are named in it.
  - given-names: Edoardo
    family-names: Bemporad
    affiliation: >-
      Department of Civil, Computer Science and Aeronautical Technologies,
      Università degli Studi Roma Tre, Rome, Italy; and Institute for Polymers,
      Composites and Biomaterials, National Research Council, Pozzuoli, Italy

# Reserved on a Zenodo draft, so the string is permanent but does not resolve
# until the record is published on acceptance. It is quoted in the README and
# in the paper's data availability statement, and the three must agree.
doi: 10.5281/zenodo.22283997

preferred-citation:
  type: article
  title: >-
    Estimating the flexural modulus of a hybrid flax/basalt/PA-11 laminate from
    high-speed nanoindentation mapping and a rule of mixtures
  authors:
    - given-names: Edoardo
      family-names: Rossi
    - given-names: Pietro
      family-names: Russo
    - given-names: Fabrizio
      family-names: Sarasini
    - given-names: Jacopo
      family-names: Tirillò
    - given-names: Edoardo
      family-names: Bemporad
  journal: Composites Part A
